#!ipxe

dhcp || shell

# Fluxo atual:
# UEFI/PXE → iPXE → (DHCP dhcp-boot) → boot.ipxe (gerado pelo knyc)
# dnsmasq fornece a URL/arquivo em ${filename}. Mantemos fallback em /boot.ipxe.

# Ocultar terminal e mostrar splash screen de loading
console --picture splash.png ||
colour --basic 0 7 || 

# Prompt oculto de 2 segundos. Se pressionar 's', abre o shell.
prompt --key s --timeout 2000 ... || goto boot

:boot
chain ${filename} || chain /boot.ipxe || goto fail

:fail
echo Falha ao dar boot no Kryonix Node Client.
shell

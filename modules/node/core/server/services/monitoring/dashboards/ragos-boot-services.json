{
  "uid": "node-boot",
  "title": "NODE - Boot & Serviços",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "tags": ["node"],
  "panels": [
    {
      "type": "stat",
      "title": "HTTP boot OK",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "node_http_boot_ok", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Doctor",
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "node_doctor_unhealthy", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "HEALTHY" }, "1": { "text": "UNHEALTHY" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Serviços críticos (systemd active)",
      "id": 3,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "targets": [
        { "expr": "node_systemd_unit_state{name=\"dnsmasq.service\",state=\"active\"}", "legendFormat": "dnsmasq", "refId": "A" },
        { "expr": "node_systemd_unit_state{name=\"nginx.service\",state=\"active\"}", "legendFormat": "nginx", "refId": "B" },
        { "expr": "node_systemd_unit_state{name=\"nfs-server.service\",state=\"active\"}", "legendFormat": "nfs-server", "refId": "C" },
        { "expr": "node_systemd_unit_state{name=\"prometheus.service\",state=\"active\"}", "legendFormat": "prometheus", "refId": "D" },
        { "expr": "node_systemd_unit_state{name=\"grafana.service\",state=\"active\"}", "legendFormat": "grafana", "refId": "E" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] }
    }
  ]
}

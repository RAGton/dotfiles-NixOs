# Tema Plymouth do RAGOS.
# Baseado na estrutura do tema "script" upstream do Plymouth, mas reduzido
# para um fluxo de boot limpo: fundo escuro, logo central, pulso discreto,
# animacao curta de shards e barra de progresso real.

Window.SetBackgroundTopColor(0.02, 0.03, 0.05);
Window.SetBackgroundBottomColor(0.01, 0.02, 0.03);

status = "normal";

background.image = Image("background.png");
background.sprite = Sprite(background.image);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.opacity_angle = 0;

activity.frames[0] = Image("frames/frame-01.png");
activity.frames[1] = Image("frames/frame-02.png");
activity.frames[2] = Image("frames/frame-03.png");
activity.frames[3] = Image("frames/frame-04.png");
activity.frames[4] = Image("frames/frame-05.png");
activity.frames[5] = Image("frames/frame-06.png");
activity.frames[6] = Image("frames/frame-07.png");
activity.frames[7] = Image("frames/frame-08.png");
activity.frames[8] = Image("frames/frame-09.png");
activity.frames[9] = Image("frames/frame-10.png");
activity.frames[10] = Image("frames/frame-11.png");
activity.frames[11] = Image("frames/frame-12.png");
activity.frame_count = 12;
activity.frame_index = 0;
activity.tick = 0;
activity.sprite = Sprite(activity.frames[0]);

progress.track.image = Image("progress-track.png");
progress.track.sprite = Sprite(progress.track.image);
progress.fill.original_image = Image("progress-fill.png");
progress.fill.image = progress.fill.original_image.Scale(1, progress.fill.original_image.GetHeight());
progress.fill.sprite = Sprite(progress.fill.image);

message.image = Image();
message.sprite = Sprite(message.image);

fun relayout() {
  center_x = Window.GetX() + Window.GetWidth() / 2;
  center_y = Window.GetY() + Window.GetHeight() / 2;

  background.sprite.SetPosition(
    center_x - background.image.GetWidth() / 2,
    center_y - background.image.GetHeight() / 2,
    -20
  );

  logo.x = center_x - logo.image.GetWidth() / 2;
  logo.y = center_y - logo.image.GetHeight() / 2 - 58;
  logo.sprite.SetPosition(logo.x, logo.y, 40);

  activity.x = center_x - activity.frames[0].GetWidth() / 2;
  activity.y = logo.y + logo.image.GetHeight() + 24;
  activity.sprite.SetPosition(activity.x, activity.y, 45);

  progress.track.x = center_x - progress.track.image.GetWidth() / 2;
  progress.track.y = activity.y + activity.frames[0].GetHeight() + 24;
  progress.track.sprite.SetPosition(progress.track.x, progress.track.y, 40);
  progress.fill.sprite.SetPosition(progress.track.x, progress.track.y, 41);

  if (message.image.GetWidth() > 0) {
    message.sprite.SetPosition(
      center_x - message.image.GetWidth() / 2,
      progress.track.y + progress.track.image.GetHeight() + 18,
      50
    );
  }
}

fun refresh_callback() {
  relayout();

  if (status == "normal") {
    logo.opacity_angle += ((2 * 3.14) / 60) * 0.35;
    min_opacity = 0.82;
    opacity = (Math.Cos(logo.opacity_angle) + 1) / 2;
    opacity *= 1 - min_opacity;
    opacity += min_opacity;
    logo.sprite.SetOpacity(opacity);

    activity.tick += 1;
    if (activity.tick >= 3) {
      activity.tick = 0;
      activity.frame_index += 1;
      if (activity.frame_index >= activity.frame_count)
        activity.frame_index = 0;
      activity.sprite.SetImage(activity.frames[activity.frame_index]);
    }

    activity.sprite.SetOpacity(0.95);
  } else {
    logo.sprite.SetOpacity(1);
    activity.sprite.SetOpacity(0.8);
  }
}

fun display_normal_callback() {
  status = "normal";
  message.sprite.SetOpacity(0);
}

fun display_message_callback(text) {
  status = "message";
  message.image = Image.Text(text, 0.78, 0.84, 0.90);
  message.sprite.SetImage(message.image);
  message.sprite.SetOpacity(1);
  relayout();
}

fun hide_message_callback(text) {
  status = "normal";
  message.sprite.SetOpacity(0);
}

fun display_password_callback(prompt, bullets) {
  status = "message";
  message_text = prompt;
  if (bullets > 0)
    message_text = prompt + " " + bullets;

  message.image = Image.Text(message_text, 0.90, 0.94, 0.98);
  message.sprite.SetImage(message.image);
  message.sprite.SetOpacity(1);
  relayout();
}

fun progress_callback(duration, progress_value) {
  width = Math.Int(progress.fill.original_image.GetWidth() * progress_value);

  if (width <= 0) {
    progress.fill.sprite.SetOpacity(0);
    return;
  }

  if (width > progress.fill.original_image.GetWidth())
    width = progress.fill.original_image.GetWidth();

  if (progress.fill.image.GetWidth() != width) {
    progress.fill.image = progress.fill.original_image.Scale(width, progress.fill.original_image.GetHeight());
    progress.fill.sprite.SetImage(progress.fill.image);
  }

  progress.fill.sprite.SetOpacity(1);
  relayout();
}

fun quit_callback() {
  logo.sprite.SetOpacity(1);
  activity.sprite.SetOpacity(0);
  message.sprite.SetOpacity(0);
}

progress.fill.sprite.SetOpacity(0);
message.sprite.SetOpacity(0);
relayout();

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetQuitFunction(quit_callback);

# =============================================================================
# Exemplo de /etc/kryonix/hermes.env  (HERMES_ENV) — SECRETS da Aura/Hermes.
#
# Copie para /etc/kryonix/hermes.env (modo 600, root:root), preencha as chaves
# e NUNCA versione o arquivo real. O `.gitignore` já ignora /etc/kryonix/hermes.env
# e *.env — este .example é o único versionado.
#
#   sudo install -m 600 /dev/null /etc/kryonix/hermes.env
#   sudo $EDITOR /etc/kryonix/hermes.env
# =============================================================================

# --- API keys (preencha as que tiver; providers sem chave são ignorados) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
CODEX_API_KEY=

# --- Roteamento da camada Aura ---
HERMES_PROVIDER_PRIMARY=claude
HERMES_PROVIDER_FALLBACKS=gemini,codex,openai

# --- Modelos por provider (ajuste aos ids reais do catálogo do `hermes`) ---
# Descubra os ids suportados com: hermes doctor / catálogo de modelos do hermes.
AURA_MODEL_CLAUDE=claude-sonnet-4-5
AURA_MODEL_GEMINI=gemini-2.5-flash
AURA_MODEL_CODEX=gpt-5-codex
AURA_MODEL_OPENAI=gpt-4o
